# ================================
# SIMRT PRODUCTION ENVIRONMENT
# 🔒 ULTRA-SECURE CONFIGURATION
# ================================

# Application Settings (HARDENED)
APP_NAME="SIMRT - Sistem Informasi RT"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Security Keys (GENERATE NEW FOR PRODUCTION)
APP_KEY=base64:GENERATE_NEW_KEY_IN_PRODUCTION
JWT_SECRET=GENERATE_NEW_JWT_SECRET_FOR_PRODUCTION

# Database Configuration (PRODUCTION)
DB_CONNECTION=mysql
DB_HOST=your_production_database_host
DB_PORT=3306
DB_DATABASE=simrt_production
DB_USERNAME=simrt_db_user
DB_PASSWORD=STRONG_RANDOM_PASSWORD_HERE

# Redis Cache (RECOMMENDED FOR PRODUCTION)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=REDIS_STRONG_PASSWORD
REDIS_PORT=6379

# Session Security (ULTRA-SECURE)
SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_COOKIE=simrt_session

# Cache Configuration (PRODUCTION)
CACHE_STORE=redis
CACHE_PREFIX=simrt_cache

# Queue Configuration (PRODUCTION)
QUEUE_CONNECTION=redis

# Logging (SECURITY FOCUSED)
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Mail Configuration (PRODUCTION)
MAIL_MAILER=smtp
MAIL_HOST=your_smtp_host
MAIL_PORT=587
MAIL_USERNAME=your_email@yourdomain.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="SIMRT System"

# Google OAuth (PRODUCTION CREDENTIALS)
GOOGLE_CLIENT_ID=your_production_google_client_id
GOOGLE_CLIENT_SECRET=your_production_google_client_secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback

# Security Headers & CORS (STRICT)
CORS_ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"
CORS_ALLOWED_METHODS="GET,POST,PUT,DELETE,OPTIONS"
CORS_ALLOWED_HEADERS="Content-Type,Authorization,X-Requested-With,X-CSRF-TOKEN"
CORS_SUPPORTS_CREDENTIALS=true

# Rate Limiting (AGGRESSIVE)
AUTH_RATE_LIMIT=3
AUTH_RATE_WINDOW=300
API_RATE_LIMIT=60
API_RATE_WINDOW=60

# File Upload Security
MAX_UPLOAD_SIZE=2048
ALLOWED_FILE_TYPES="jpg,jpeg,png,pdf,doc,docx"
UPLOAD_SCAN_VIRUS=true

# Database Security
DB_STRICT_MODE=true
DB_FOREIGN_KEY_CHECKS=true
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# HTTPS & SSL (MANDATORY)
FORCE_HTTPS=true
SSL_VERIFY_PEER=true
SSL_VERIFY_HOST=true

# Security Features
ENABLE_2FA=true
ENABLE_IP_WHITELIST=false
ENABLE_GEO_BLOCKING=false
ENABLE_BOT_DETECTION=true
ENABLE_AUDIT_LOGGING=true

# Backup & Recovery
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION=true

# Monitoring & Alerting
MONITORING_ENABLED=true
ALERT_EMAIL=admin@yourdomain.com
ALERT_WEBHOOK_URL=https://hooks.slack.com/your-webhook

# Content Security Policy
CSP_ENABLED=true
CSP_REPORT_URI=https://yourdomain.com/csp-report

# Advanced Security
ENABLE_HONEYPOT=true
ENABLE_FAIL2BAN=true
ENABLE_DDOS_PROTECTION=true
ENABLE_WAF=true

# Development Settings (DISABLED IN PRODUCTION)
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false
HORIZON_ENABLED=false
